# Luxi Social Agent — copy to .env and fill in what you use.
# With nothing but the defaults the app runs in DEMO MODE: simulated accounts, metrics and
# placeholder media, so every screen and step can be tried safely.

# ------------------------------------------------------------------ app
# Public base URL. OAuth callbacks, webhooks and (with local storage) media URLs are built from it.
# Instagram downloads post media from this URL, so in production it must be public HTTPS.
APP_URL=http://localhost:3000
AGENCY_NAME=Luxi Capture
OWNER_NAME=Morteza
# Your IANA time zone (e.g. Asia/Dubai, Europe/London, America/Toronto): daily KPI check 06:30,
# daily watch 07:00, weekly review Monday 08:00 and quiet hours run on it.
AGENCY_TIMEZONE=UTC
# auto = demo mode until ANTHROPIC_API_KEY is set; true/false to force.
DEMO_MODE=auto

# ------------------------------------------------------------------ sign-in (single owner account)
ADMIN_EMAIL=you@example.com
# Either a plain password (dev only) or a scrypt hash: npm run hash-password -- 'your long password'
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# ------------------------------------------------------------------ secrets (required in production)
# 32+ random characters each, e.g. `openssl rand -base64 48`. Changing ENCRYPTION_KEY makes saved
# platform tokens unreadable (reconnect the accounts).
SESSION_SECRET=
ENCRYPTION_KEY=

# ------------------------------------------------------------------ database & files
# Empty = embedded PGlite database in DATA_DIR (zero setup; one process only).
# Set a Postgres URL for production or to run the worker as a separate process.
DATABASE_URL=
DATA_DIR=./data

# ------------------------------------------------------------------ worker
# in-process: the agent's job loop runs inside the web server (simplest).
# off: run `npm run worker` separately (needs DATABASE_URL) or call /api/cron/tick every minute.
RUN_WORKER=in-process
WORKER_TICK_SECONDS=20
# Shared secret for GET /api/cron/tick (Authorization: Bearer <secret>). Empty = endpoint disabled.
CRON_SECRET=

# ------------------------------------------------------------------ Claude (the agent's brain)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# default = if a request is declined, retry it on the platform's fallback model; off = never.
CLAUDE_FALLBACKS=default

# ------------------------------------------------------------------ generation
# Higgsfield API key pair from cloud.higgsfield.ai → API keys, formatted KEY_ID:KEY_SECRET
HIGGSFIELD_CREDENTIALS=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# ElevenLabs API key (voiceover with word timings, music, sound effects)
ELEVENLABS_API_KEY=
# Optional default voice; otherwise the director casts one per piece.
ELEVENLABS_DEFAULT_VOICE_ID=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ------------------------------------------------------------------ media storage
# local = files in DATA_DIR/media served at APP_URL/api/media/… (APP_URL must be public for Instagram)
# s3 = any S3-compatible bucket with public reads (Cloudflare R2, AWS S3, Supabase Storage…)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket, e.g. https://media.yourdomain.com
S3_PUBLIC_BASE_URL=

# ------------------------------------------------------------------ Meta (Instagram + Facebook Pages)
# developers.facebook.com → your Business app. Redirect URI: APP_URL/api/connect/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# Optional: Facebook Login for Business configuration id
META_LOGIN_CONFIG_ID=
# Webhooks (comments/messages in seconds): callback APP_URL/api/webhooks/meta with this token
META_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------------ LinkedIn (company pages)
# linkedin.com/developers → app with the Community Management API. Redirect: APP_URL/api/connect/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202608
# LINKEDIN_SCOPES=r_organization_social w_organization_social rw_organization_admin w_member_social openid profile

# ------------------------------------------------------------------ X
# developer.x.com → app with OAuth 2.0 (type: Web App). Callback: APP_URL/api/connect/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# X_SCOPES=tweet.read tweet.write users.read offline.access media.write dm.read dm.write

# ------------------------------------------------------------------ Metricool (optional publishing route)
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=

# ------------------------------------------------------------------ notifications
# Web Push for phone/desktop: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional Telegram: create a bot with @BotFather, then message it and read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
