    "hash-password": "tsx scripts/hash-password.ts",
    "agent": "tsx src/worker/run-once.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@electric-sql/pglite": "0.5.8",
    "aws4fetch": "1.0.20",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
