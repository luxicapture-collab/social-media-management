{
  "name": "luxi-social-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous, goal-driven social media agent for agency clients: Instagram, Facebook, LinkedIn and X.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate-cli.ts",
    "seed:demo": "tsx src/server/demo/seed-cli.ts",
